{
  "name": "@imikailoby/mariflag",
  "version": "3.0.0",
  "description": "Versatile SVG Generator for Custom Icon Sequences. Inspired by International Maritime Signal Flags",
  "author": "Mikhail Prosmitskiy",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/imikailoby/mariflag.git"
  },
  "homepage": "https://github.com/imikailoby/mariflag#readme",
  "bugs": {
    "url": "https://github.com/imikailoby/mariflag/issues"
  },
  "type": "commonjs",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "lint": "eslint src/",
    "test": "jest",
    "test:coverage": "jest --collectCoverage",
    "format": "prettier . --write --log-level warn",
    "demo:bundle": "tsup src/index.ts --format iife --global-name mariflag --out-dir demo/vendor --no-dts",
    "prepublishOnly": "npm run lint && npm test && npm run build"
  },
  "keywords": [
    "maritime",
    "signal-flags",
    "flags",
    "svg",
    "icons",
    "generator",
    "typescript"
  ],
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^25.9.2",
    "eslint": "^10.4.1",
    "jest": "^30.4.2",
    "prettier": "^3.3.3",
    "ts-jest": "^29.4.11",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.60.1"
  },
  "overrides": {
    "picomatch": "^4.0.4"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
